/* pages/profile/profile.wxss */
page {
  background-color: #f5f5f5;
}

.user-card {
  background-color: white;
  padding: 40rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  background-color: #eee;
  border-radius: 50%;
  margin-right: 30rpx;
}

.info {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.uid {
  font-size: 24rpx;
  color: #999;
}

.stats-card {
  background-color: white;
  padding: 30rpx 0;
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.num {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.label {
  font-size: 24rpx;
  color: #666;
}
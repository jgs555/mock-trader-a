/* pages/index/index.wxss */
.home-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background-color: #f5f5f5;
}

.title-area {
  margin-bottom: 120rpx;
  text-align: center;
}

.main-title {
  font-size: 56rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.sub-title {
  font-size: 32rpx;
  color: #888;
  margin-top: 16rpx;
  display: block;
}

.btn-area {
  width: 80%;
}

.action-btn {
  margin-bottom: 40rpx;
  border-radius: 50rpx;
  font-size: 34rpx;
  padding: 20rpx 0;
  font-weight: bold;
}

.match-btn {
  background-color: #d81e06;
  color: white;
  box-shadow: 0 6rpx 12rpx rgba(216, 30, 6, 0.3);
}

.train-btn {
  background-color: white;
  color: #d81e06;
  border: 2rpx solid #d81e06;
}